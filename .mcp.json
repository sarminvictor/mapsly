{
  "$schema": "https://docs.claude.com/schema/mcp.json",
  "_comment": "Claude Code does NOT read .env.local at MCP startup, so ${VAR} interpolation never resolves. Servers that need secrets are wrapped in `sh -c` which sources .env.local itself (Boxly pattern). gsc/ga use the shared service-account file directly. Restart Claude Code after changes.",
  "mcpServers": {
    "postgres": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "set -a && . /Users/Viktor/Documents/Claude/Projects/mapsly/.env.local && set +a && exec npx -y @modelcontextprotocol/server-postgres \"$DATABASE_URL\""
      ]
    },
    "gsc": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-google-search-console"],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "/Users/Viktor/.config/gsc/service-account.json"
      }
    },
    "ga": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-google-analytics-oauth2"],
      "env": {
        "GOOGLE_AUTH_MODE": "service_account",
        "GOOGLE_CREDENTIALS_PATH": "/Users/Viktor/.config/gsc/service-account.json"
      }
    },
    "dataforseo": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "set -a && . /Users/Viktor/Documents/Claude/Projects/mapsly/.env.local && set +a && DATAFORSEO_USERNAME=\"$DATAFORSEO_LOGIN\" exec npx -y @dataforseo/mcp-server"
      ]
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp"
    }
  }
}
