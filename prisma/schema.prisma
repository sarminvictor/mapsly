// ============================================================================
// STRIPE WEBHOOK EVENT · idempotency log
//
// Every webhook delivery from Stripe is recorded here BEFORE the side-effects
// run. The `eventId` UNIQUE constraint provides at-most-once processing
// semantics — Stripe retries deliveries on non-2xx, and we INSERT-then-handle
// so a duplicate delivery hits the unique violation and short-circuits.
//
// `processedAt` is stamped after the handler returns successfully. Rows with
// `processedAt = NULL` are deliveries that started processing but failed
// mid-way — surfaced by the payments-auditor cron / dashboard, replayed by
// hand. Stripe will re-deliver too.
//
// `error` carries the last error message when a delivery failed; cleared
// on successful replay. Body is captured raw (`payload`) for forensic
// debugging — never relied on at runtime (the handler operates on the
// Stripe.Event object, not the raw payload).
// ============================================================================

model StripeWebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique // Stripe Event.id — at-most-once key
  type        String // Stripe Event.type (e.g. "invoice.paid")
  apiVersion  String? // Stripe API version sent by the event
  livemode    Boolean   @default(false)
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?   @db.Text
  payload     Json // raw event body for forensics

  @@index([type])
  @@index([receivedAt])
  @@index([processedAt])
}

// ============================================================================
// DISCOVERY REGISTRY · admin-curated category/location pairs that the
// /admin/discovery panel runs against. Replaces the cron-based daily/monthly
// indexer (retired May 2026). See docs/data-cadence.md and the preplan
// (Phase 1 = Med Spa × LA/Miami/Phoenix/Toronto).
// ============================================================================

// Verified category (vertical) we're allowed to discover against. Admin
// adds rows from a curated list; cell-level pings against DataForSEO
// confirm the category yields real businesses before insertion. No free
// text — only legitimate, picked categories enter this table.
model BusinessCategory {
  id              String   @id @default(cuid())
  dataforseoId    String   @unique // DfS category slug (e.g. "medical_spa")
  label           String // human-friendly: "Medical Spa"
  groupKey        String? // optional meta-group: "beauty_and_wellness"
  isActive        Boolean  @default(true) // soft-disable without dropping history
  verifiedAt      DateTime // when we confirmed via ping
  createdAt       DateTime @default(now())
  createdByUserId String?

  trackedLocations TrackedLocation[]
  discoveryRuns    DiscoveryRun[]

  @@index([groupKey, label])
  @@index([isActive])
}

// (category × city × country × radius) cell the admin elects to track.
// Each row is a knob the admin can run discovery against on demand. The
// denormalized aggregate fields render the page without joining
// DiscoveryRun on every load.
model TrackedLocation {
  id         String           @id @default(cuid())
  categoryId String
  category   BusinessCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Location identity — geocoded + ping-verified at insertion
  city       String
  province   String?
  country    String // ISO-2: "US", "CA"
  lat        Float
  lng        Float
  radiusKm   Int      @default(5)
  verifiedAt DateTime // last successful ping (limit=1 mapsSearch)

  // Soft-disable so admin can pause a cell without losing run history
  isActive Boolean @default(true)

  // Denormalized aggregates — updated on each run completion
  businessCount      Int       @default(0) // current Business rows matching this cell
  lastRunAt          DateTime?
  totalRuns          Int       @default(0)
  totalNewFound      Int       @default(0)
  totalCostUsd       Float     @default(0)
  // DfS total_count from the latest run — how many listings Google has
  // in this cell. businessCount vs this = coverage / saturation.
  lastTotalAvailable Int?

  // Qualification aggregates · updated when admin runs Qualify
  qualifiedCount      Int       @default(0)
  disqualifiedCount   Int       @default(0)
  unreachableCount    Int       @default(0)
  lastQualifyAt       DateTime?
  totalQualifyCostUsd Float     @default(0)

  // Activity aggregates · updated when admin runs Check Activity
  activeCount          Int       @default(0)
  staleCount           Int       @default(0)
  noReviewsCount       Int       @default(0)
  lastActivityCheckAt  DateTime?
  totalActivityCostUsd Float     @default(0)

  // ── Agency rework (additive) · metro-keying + 182-day discovery freshness
  // (§4.2, §4.3). The metro unique-key swap is a SEPARATE guarded migration —
  // the existing @@unique below stays UNCHANGED here.
  metroSlug           String?
  cbsaGeoid           String?
  radiusTier          String?
  geocodeSource       String?
  lastDiscoveredAt    DateTime?
  lastDiscoveryStatus DiscoveryRunStatus?
  nextStaleAt         DateTime? // denormalized = lastDiscoveredAt + 182d
  rawDataVersion      Int                 @default(1)
  geohash             String?

  createdAt       DateTime @default(now())
  createdByUserId String?

  discoveryRuns DiscoveryRun[]

  @@unique([categoryId, city, province, country])
  @@index([categoryId, lastRunAt])
  @@index([isActive])
  @@index([metroSlug])
  @@index([nextStaleAt])
}

// Audit trail — one row per admin-triggered discovery click. Captures
// what we asked, what we got, what was new vs dup, and the cost. Drives
// the "Recent runs" table + per-cell drill-in.
model DiscoveryRun {
  id                String           @id @default(cuid())
  trackedLocationId String
  trackedLocation   TrackedLocation  @relation(fields: [trackedLocationId], references: [id], onDelete: Cascade)
  categoryId        String // denormalized for filtering
  category          BusinessCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  startedAt         DateTime           @default(now())
  finishedAt        DateTime?
  status            DiscoveryRunStatus @default(RUNNING)
  triggeredByUserId String?

  // What we asked DataForSEO
  radiusKm       Int
  limitRequested Int

  // What we got back
  totalReturned  Int     @default(0)
  // DfS total_count — listings available in the cell at run time.
  // totalReturned < totalAvailable ⇒ the cell wasn't fully pulled.
  totalAvailable Int?
  newBusinesses  Int     @default(0)
  duplicates     Int     @default(0)
  errors         Int     @default(0)
  costUsd        Float   @default(0)
  errorMessage   String? @db.Text
  meta           Json?

  @@index([trackedLocationId, startedAt(sort: Desc)])
  @@index([categoryId, startedAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
  @@index([status])
}

enum DiscoveryRunStatus {
  RUNNING
  OK
  PARTIAL
  FAILED
}

// ===================================================================
// Cold Email Engine · self-hosted SMTP outreach (mapsly.xyz)
// Patterns referenced from Boxly, re-implemented for Mapsly + cold.
// Walled off from the Resend magic-link sender (mapsly.ai).
// ===================================================================

model ColdCampaign {
  id                  String             @id @default(cuid())
  name                String
  status              ColdCampaignStatus @default(DRAFT)
  locale              String             @default("en")
  country             String             @default("US") // geo gate (CASL: keep CA out until consent records)
  fromName            String? // optional per-campaign override of COLD_FROM_NAME
  sendWindowStartHour Int                @default(9) // local hour, inclusive
  sendWindowEndHour   Int                @default(17) // local hour, exclusive
  sendTimezone        String             @default("America/New_York")
  weekdaysOnly        Boolean            @default(true)
  dailyEnrollCap      Int                @default(100)
  steps               ColdStep[]
  recipients          ColdRecipient[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([status])
}

model ColdStep {
  id              String       @id @default(cuid())
  campaignId      String
  campaign        ColdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  stepOrder       Int // 0-based touch index
  subjectTemplate String
  bodyTemplate    String       @db.Text // plain-text with {{tokens}} + {{#if}}
  delayDays       Int          @default(0) // delay AFTER the previous step
  delayHours      Int          @default(0)
  conditions      Json? // { skipIf: { replied, clicked, unsubscribed } }
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([campaignId, stepOrder])
}

model ColdRecipient {
  id          String              @id @default(cuid())
  campaignId  String
  campaign    ColdCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  businessId  String? // soft ref to Business (no FK — keeps Business model untouched)
  email       String
  locale      String              @default("en")
  status      ColdRecipientStatus @default(PENDING)
  currentStep Int                 @default(0)
  nextRunAt   DateTime?
  reportToken String? // full landing param "slug-token" (modules/cold/enroll.ts) → /l/[reportToken]
  stopReason  String?
  lastError   String?
  context     Json? // optional cached personalization snapshot
  sends       ColdSend[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([campaignId, email])
  @@index([status, nextRunAt])
  @@index([campaignId, status])
  @@index([businessId])
}

model ColdSend {
  id             String         @id @default(cuid())
  recipientId    String
  recipient      ColdRecipient  @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  stepOrder      Int
  mailboxAddress String? // which mailbox sent it
  status         ColdSendStatus @default(PENDING)
  scheduledFor   DateTime
  sentAt         DateTime?
  attempts       Int            @default(0)
  idempotencyKey String         @unique // `${recipientId}:${stepOrder}` — prevents double-send
  subject        String?
  bounceReason   String?
  errorMessage   String?

  // ── Open tracking · /o/[token] pixel (plan #7) ─────────────────────────
  // RAW signals only — classification lives in lib/bot-detect.ts so the
  // heuristics can evolve and stats can be re-derived retroactively. Opens
  // are a FUZZY UPPER BOUND (Apple MPP + Gmail image proxies auto-fetch,
  // inflating ~50%) — clicks/landing visits are the truth (plan #17).
  firstOpenedAt      DateTime?
  lastOpenedAt       DateTime?
  openCount          Int       @default(0) // NOT NULL — incremented (prisma.md §5b)
  firstOpenUserAgent String?   @db.Text
  // True while EVERY open so far looks like machine prefetch (<5s after
  // sentAt or a known image-proxy UA — lib/bot-detect.isPrefetchOpen).
  // Cleared by the pixel route the first time a human-looking open arrives.
  // Denormalized hint for cheap human-open stats; raw fields above stay
  // authoritative for reclassification.
  suspectedPrefetch  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledFor])
  @@index([recipientId])
  @@index([firstOpenedAt])
}

model ColdSuppression {
  id        String                @id @default(cuid())
  email     String                @unique
  source    ColdSuppressionSource
  reason    String?
  createdAt DateTime              @default(now())

  @@index([email])
}

model Mailbox {
  id            String        @id @default(cuid())
  address       String        @unique // matches a COLD_MAILBOX_n env value
  domain        String
  displayName   String?
  dailyCap      Int           @default(30) // target cap once warmed
  rampStartedAt DateTime? // null = ramp not started; effective cap derived from elapsed days
  status        MailboxStatus @default(WARMING)
  blockedUntil  DateTime? // set on provider block (e.g. 550 5.4.6) cooldown
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model MailboxStat {
  id             String   @id @default(cuid())
  mailboxAddress String
  date           String // YYYY-MM-DD (UTC) — daily rotation/cap counter
  sentCount      Int      @default(0)
  failedCount    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([mailboxAddress, date])
  @@index([date])
}

model ConsentRecord {
  id            String       @id @default(cuid())
  email         String
  businessId    String?
  basis         ConsentBasis @default(CONSPICUOUS_PUBLICATION)
  sourceUrl     String? // where the business email was publicly published
  relevanceNote String? // why the message relates to the recipient's role
  country       String       @default("US")
  capturedAt    DateTime     @default(now())
  expiresAt     DateTime?

  @@index([email])
}

// Free weekly-score email list (plan #7) — the ENGAGED / nurture list. Lives
// fully OUTSIDE the cold engine by Viktor's decision: never counted against
// cold caps, never enrolled in ColdCampaign sequences, sent via the Resend
// transactional path (plan #10 shares the digest template). Unsubscribe is
// PER-SUBSCRIPTION (does NOT write ColdSuppression — opting out of the free
// digest must not also block transactional mail, and vice versa).
// Every signup writes a ConsentRecord with basis EXPRESS in the same
// transaction (soft-linked via consentRecordId).
model WeeklyScoreSubscriber {
  id            String  @id @default(cuid())
  email         String
  businessId    String? // soft ref to Business (same convention as ColdRecipient.businessId)
  landingPageId String? // soft ref to LandingPage — which landing captured the signup (attribution)

  // Unguessable random token minted at signup (crypto.randomBytes(16)
  // .toString("base64url") — STORED, unlike the stateless HMAC /u tokens,
  // because revocation is per-subscription row, not per-email).
  // → /wu/[token] unsubscribe link in every weekly email.
  unsubToken String @unique

  // Soft ref to the EXPRESS ConsentRecord written at signup (CASL/CAN-SPAM
  // defense file — proves the opt-in for this exact email + business).
  consentRecordId String?

  source         String    @default("landing") // "landing" today · future: "portal", "import"
  createdAt      DateTime  @default(now())
  unsubscribedAt DateTime? // null = active · re-subscribe clears it (row is reused, token rotates)

  // Weekly digest bookkeeping (plan #10 sender cron).
  lastSentAt DateTime?
  sendCount  Int       @default(0) // NOT NULL — incremented (prisma.md §5b)

  @@unique([email, businessId]) // re-submits are idempotent upserts
  @@index([businessId])
  @@index([unsubscribedAt, lastSentAt]) // digest cron: active subscribers due a send
}

/// Inbound marketing lead · an UNDISCOVERED business owner who typed their
/// business name + email on /for-businesses to "get a free report by email"
/// (the autosuggest found no landing for them). Distinct from `Lead` (agency
/// CRM) and `WeeklyScoreSubscriber` (already-indexed businesses). MVP =
/// capture + confirmation email + ops alert; the report itself is produced
/// and sent afterward (no live data pull at submit time).
model InboundLeadRequest {
  id           String  @id @default(cuid())
  businessName String
  email        String
  city         String?
  country      String  @default("US")

  // PENDING → CONTACTED → CONVERTED · BOUNCED (free-form, like other status cols)
  status String @default("PENDING")

  sourceUrl       String? // the /for-businesses URL the request came from
  locale          String? // visitor locale at submit (en · es · en-CA · fr)
  businessId      String? // soft ref to Business if later matched/created
  consentRecordId String? // soft ref to the EXPRESS ConsentRecord written at submit
  ipHash          String? // salted IP hash (never the raw IP) — same recipe as landing-events

  reportSentAt DateTime? // set when the report email actually goes out
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([email, businessName]) // re-submits are idempotent upserts
  @@index([status, createdAt])
}

model ColdSetting {
  key       String   @id // e.g. "globalPause"
  value     String
  updatedAt DateTime @updatedAt
