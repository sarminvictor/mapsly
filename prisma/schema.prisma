// Mapsly · core data model
// Cadence flags on each field: @daily / @weekly / @monthly / @on_demand
// Cost notes: see docs/data-cadence.md

generator client {
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

// Prisma 7: connection URLs live in prisma.config.ts (not here).
// `url` / `directUrl` are no longer accepted in the datasource block.
datasource db {
  provider = "postgresql"
}

// ============================================================================
// AUTH + ACCOUNTS
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?

  role UserRole @default(MEMBER)

  // Stripe billing — set on first checkout-session creation for SMB plans.
  // Agency plans bill against `Agency.stripeCustomerId`. See modules/billing.
  //
  // Subscription fields are written by the webhook handler (G.2). The
  // `stripeSubscriptionId` is the active subscription's id; `stripePlan`
  // is the plan literal from our registry (e.g. "smb_paid"); `stripeStatus`
  // tracks Stripe's subscription.status verbatim ("active", "past_due",
  // "canceled", etc.); `currentPeriodEnd` is the renewal anchor used for
  // feature gating + grace-period logic.
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePlan           String? // plan literal from modules/billing/plans.ts
  stripeStatus         String? // Stripe subscription.status
  stripePriceId        String? // current Stripe price id
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)

  accounts        Account[]
  sessions        Session[]
  agencyMembers   AgencyMember[]
  ownedBusinesses Business[]     @relation("BusinessOwner")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  ADMIN
  MEMBER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================================
// AGENCY (multi-tenant for the agency portal)
// ============================================================================

model Agency {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  domain           String?
  defaultMetro     String?
  categoriesServed String[] @default([])

  // Plan tier — written by the webhook handler when an agency subscription
  // becomes active (or upgrades / downgrades). Default SOLO covers the
  // pre-billing free state too — feature gating consults `stripeStatus`
  // before treating SOLO as paid.
  plan AgencyPlan @default(SOLO)

  // Stripe billing — agency plans bill against the agency, not the user.
  // See `.claude/rules/security.md` + modules/billing/webhook.ts for the
  // owner-role gate that protects these mutations.
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePlan           String? // plan literal from modules/billing/plans.ts
  stripeStatus         String? // Stripe subscription.status
  stripePriceId        String? // current Stripe price id
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)

  // ── Agency rework (additive) · CAN-SPAM mailing address + per-agency
  // concurrency / daily cost caps for background enrichment (§4.17, §4.18).
  mailingAddress    String?
  maxConcurrentRuns Int?
  dailyCostCapUsd   Float?

  // Seat cap for the flat-plan seat model (WP0-6 · Solo 1 / Growth 3 / Pro 10).
  // The wallet is already agency-level (see `AgencyWallet`, keyed by agencyId
  // @unique) — credits pool across seats; there is no per-user wallet.
  maxSeats Int?

  members AgencyMember[]
  lists   List[]
  leads   Lead[]
  reports Report[]
  invites AgencyInvite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// WP5-8 · pending seat invite. The magic-link VerificationToken is consumed by
// NextAuth itself and can't carry agencyId/role, so invites live here: the
// invite email links to /signin?invite=<token>; after the magic-link round-trip
// /post-signin resolves the token, enforces the seat cap, and creates the
// AgencyMember on the INVITING agency (never self-provisions a new one).
model AgencyInvite {
  id              String           @id @default(cuid())
  agencyId        String
  email           String
  role            AgencyMemberRole @default(STAFF)
  token           String           @unique
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@index([email])
}

enum AgencyPlan {
  SOLO // $49
  GROWTH // $99
  AGENCY_PRO // $249
  BOUTIQUE // $499
}

model AgencyMember {
  id       String           @id @default(cuid())
  agencyId String
  userId   String
  role     AgencyMemberRole @default(STAFF)

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ownedLists List[]

  createdAt DateTime @default(now())

  @@unique([agencyId, userId])
}

enum AgencyMemberRole {
  OWNER
  ADMIN
  STAFF
}

// ============================================================================
// BUSINESS · the core 2.1M index — populated by cron jobs
// ============================================================================

model Business {
  id            String  @id @default(cuid())
  googlePlaceId String? @unique // from DataForSEO Maps
  googleCid     String? @unique

  // Identity
  name       String
  slug       String   @unique
  category   String // primary category
  categories String[] @default([])
  address    String?
  city       String?
  province   String? // state for US
  country    String?
  postalCode String?
  lat        Float?
  lng        Float?

  // Contact
  phone              String?
  website            String?
  email              String? // verified owner email — see emailVerifiedAt
  emailVerifiedAt    DateTime?
  instagramHandle    String?
  instagramFollowers Int?

  // Profile state (weekly snapshot of current values)
  rating            Float?
  reviewCount       Int?
  photosCount       Int?
  hours             Json? // structured hours (DfS work_time.work_hours.timetable)
  attributes        Json? // DfS attributes — accessibility, payments, planning, etc.
  isClaimed         Boolean   @default(false)
  isActive          Boolean   @default(true)
  firstSeenOnGoogle DateTime?
  yearsOnGoogle     Int?

  // Extended DfS capture · everything the Maps Listings response returns
  // that's worth indexable / queryable on its own. The full raw row is
  // preserved in `sourceRawJson` so any forensic re-extraction is cheap.
  description         String?   @db.Text // business bio (long-form)
  originalTitle       String? // alt-language title when present
  featureId           String? // Google internal feature_id (hex pair · distinct from CID)
  domain              String? // pre-extracted host from url
  logoUrl             String? // Google-hosted logo
  mainImageUrl        String? // primary photo
  snippet             String? // short rendered text (usually the address)
  checkUrl            String? // direct Google Maps URL for this listing
  categoryIds         String[]  @default([]) // DfS category slugs (e.g. "medical_spa") — vs `categories[]` which is display names
  ratingDistribution  Json? // {1: n, 2: n, 3: n, 4: n, 5: n}
  placeTopics         Json? // {keyword: count} extracted by DfS from reviews · gold for review themes
  peopleAlsoSearch    Json? // top 5 competitor seeds Google's own algorithm surfaces
  popularTimes        Json? // hours-of-day occupancy histogram
  localBusinessLinks  Json? // booking, reservations, menu links
  // Derived from localBusinessLinks at persist: does the Google profile expose a
  // reservation/appointment/booking link? Powers the gbp_no_booking signal (E10)
  // — distinct from has_booking_widget (the on-site DOM booking tool).
  gbpHasBooking       Boolean?
  contactInfo         Json? // typed contact channels with provenance
  sourceLastUpdatedAt DateTime? // when DfS itself last refreshed this row
  sourceRawJson       Json? // entire DfS row · forensic recovery

  // Owner (if claimed in Mapsly by their SMB user)
  ownerUserId String?
  owner       User?   @relation("BusinessOwner", fields: [ownerUserId], references: [id])

  // Provenance · which path created this row (admin discovery / manual seed /
  // SMB self-claim / future Hunter expand). Defaults to DISCOVERY since that's
  // the production path; manual seeds set it explicitly.
  source BusinessSource @default(DISCOVERY)

  // Qualification · checked on /admin/discovery
  qualificationStatus QualificationStatus @default(NOT_QUALIFIED)
  qualificationFlags  String[]            @default([]) // ["unclaimed","low_reviews","no_email","no_website"]
  qualifiedAt         DateTime?
  qualifiedByUserId   String?

  // Email discovery · best candidate found across scrape + RDAP
  emailDiscovered      String?
  emailDiscoverySource EmailDiscoverySource?
  emailDiscoveredAt    DateTime?
  emailCandidates      Json? // ranked array [{ email, source, score }, ...]

  // Activity · checked on /admin/activity (separate page)
  activityStatus          ActivityStatus @default(NOT_CHECKED)
  lastReviewAt            DateTime?
  activityCheckedAt       DateTime?
  activityCheckedByUserId String?

  // Review collection cursor · drives the qualify→pull hook (R.2) +
  // weekly delta cron (R.3). `reviewsFirstPulledAt` is set when the
  // initial deep historical pull completes. `reviewsLastDeltaAt` is
  // updated by every subsequent weekly delta (success or no-op).
  // `latestReviewExternalId` + `latestReviewPostedAt` mark the top
  // review at the last pull — used as the cursor-stop signal so delta
  // walks stop as soon as they hit a previously-seen review (no dupes,
  // bounded cost). `pendingReviewsTaskId` holds the DfS Standard-queue
  // task_id while a pull is in-flight · cleared in pingback handler.
  reviewsFirstPulledAt   DateTime?
  reviewsLastDeltaAt     DateTime?
  latestReviewExternalId String?
  latestReviewPostedAt   DateTime?
  pendingReviewsTaskId   String?   @unique

  // Search visibility cursor · drives the per-biz ranked_keywords pull
  // (admin trigger + weekly cron). `searchScanLastAt` is updated on
  // every successful scan · used by the cron to pick stalest cell
  // members first. No in-flight task_id field because ranked_keywords
  // is Live (synchronous) · pingbacks don't apply.
  searchScanLastAt DateTime?

  // Ads intelligence (SMB /ads page · ads-rework)
  // Resolved Facebook Page id (cached once · rarely changes) · lets the Meta
  // Ad Library actor pull this business's OWN ads precisely via view_all_page_id
  // instead of noisy keyword search.
  fbPageId      String?
  // Freshness cursor for the ads-intelligence scan · the cron picks the
  // stalest businesses first (mirrors searchScanLastAt).
  adsScanLastAt DateTime?

  // ── Agency rework (additive) · open-status, metro/cell geo, reachability,
  // contacts denorm, compliance, enrichment freshness. Scalar columns only;
  // new related rows use plain-FK models (Contact, BusinessTech, etc.).
  openStatus             BusinessOpenStatus @default(UNKNOWN)
  openStatusAt           DateTime?
  holidayHours           Json?
  metroSlug              String?
  cbsaGeoid              String?
  cellKey                String? // "medical_spa|miami|US"
  anchorDistanceKm       Float?
  crossMetroDupe         Boolean            @default(false)
  techScanLastAt         DateTime?
  reachability           ReachabilityStatus @default(UNKNOWN)
  reachableChannelCount  Int                @default(0)
  reachabilityComputedAt DateTime?
  contactScanStatus      ContactScanStatus  @default(PENDING)
  isHidden               Boolean            @default(false)
  hiddenReason           String?
  permanentlyClosed      Boolean            @default(false)
  temporarilyClosed      Boolean            @default(false)
  contactsExtractedAt    DateTime?
  // Cleaned, truncated readable text extracted from the business's own website
  // during the contacts scan (A2). Fed to the services + AI-research jobs so the
  // model reads the real service menu / positioning copy, not just the thin
  // Google listing. Only populated on a successful site fetch; null otherwise.
  siteText               String?            @db.Text
  siteTextAt             DateTime?
  // Per-enrichment freshness cursors for the services + AI-research jobs (A4).
  // Stamped on a successful (or verified-empty) job completion so a repeat run
  // within the 90-day window is served from DB at $0 instead of re-billing.
  servicesLastAt         DateTime?
  aiResearchLastAt       DateTime?
  // B1 · per-business Google-ads freshness cursor. google_ads moved from a
  // per-cell family to a per-business job (reliable target-host attribution),
  // mirroring lighthouse: stamped by runGoogleAdsForBusiness on a successful
  // collection so a repeat run within the 30-day window is SKIPPED_FRESH at $0.
  googleAdsLastAt        DateTime?
  categoryProfileSlug    String?
  complianceFlags        String[]           @default([])
  enrichmentFreshness    Json?
  // Do-not-sell / opt-out suppression (WP0-7) · stamped by the /opt-out flow
  // (WP7-2). When set, this business is filtered out of enrichment output,
  // CSV export, touch generation, and one-pagers. Nullable = not suppressed.
  suppressedAt           DateTime?

  // Linked records
  snapshots           BusinessSnapshot[]
  reviews             Review[]
  lighthouseAudits    LighthouseAudit[]
  adLibraryEntries    AdLibraryEntry[]
  serpResults         SerpResult[]
  businessKeywords    BusinessKeyword[]
  quickWinAssignments QuickWinAssignment[]
  leads               Lead[]
  services            BusinessService[]
  landingPage         LandingPage?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastRefreshedAt DateTime?

  @@index([category, city])
  @@index([country, province, city])
  @@index([lat, lng])
  @@index([category, country])
  @@index([openStatus])
  @@index([metroSlug])
  @@index([cellKey])
  @@index([isHidden])
  // WP9-4 · covering index for the raw-list read model (modules/discovery/
  // raw-list.ts): the query filters `cellKey IN (...)` and sorts
  // `reviewCount DESC NULLS LAST, id ASC`. The single-column [cellKey] index
  // served the filter but forced an in-memory sort of the whole cell; this
  // composite lets Postgres walk the cell in review-count order directly, so
  // per-cell pages (Preview sample + workbench) come back in index order at
  // 2.1M scale. `id ASC` (the cursor tiebreak) rides the primary key.
  @@index([cellKey, reviewCount(sort: Desc)])
}

enum BusinessSource {
  DISCOVERY // Admin-triggered discovery run
  MANUAL_SEED // One-off seed script (e.g., Solea)
  ONBOARDING // SMB self-claim during onboarding (future)
  HUNTER_EXPAND // Agency "expand to Google" affordance (future)
}

enum QualificationStatus {
  NOT_QUALIFIED // default · never checked
  QUALIFIED // claimed + ≥10 reviews + email found
  DISQUALIFIED // fails ≥1 criterion but reachable
  UNREACHABLE // no email + no website
  FAILED // qualification call errored
}

enum EmailDiscoverySource {
  SCRAPE_HOMEPAGE
  SCRAPE_CONTACT
  SCRAPE_ABOUT
  SCRAPE_TEAM
  SCRAPE_FOOTER
  SCRAPE_BOOKING
  SCRAPE_JS_BUNDLE
  // AI fallback · gpt-5.4-nano + web_search_preview tool. Triggers
  // only when scrape + RDAP both produce zero candidates. Cost
  // ~$0.027/business. Cited URL stored in Business.emailCandidates.
  AI_WEB_SEARCH
  RDAP
  MANUAL
}

enum ActivityStatus {
  NOT_CHECKED
  ACTIVE // ≥1 review in last 90 days
  STALE // last review older than 90 days
  NO_REVIEWS // never reviewed
  FAILED
}

// What the business offers · the contextual lens for every analysis.
// SMB portal lets Maria edit this list; cron jobs auto-detect candidates
// from Google Business categories + DOM scrape on first sync. Services
// drive review-theme grouping, keyword matching, ad-creative comparison,
// and per-service website page checks. See `.claude/rules/ui-ux-smb.md`
// and the SMB portal restructure (v0.8.x).
model BusinessService {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Display
  name        String // "Botox", "Lip filler", "Brow lamination"
  category    String? // "Injectables", "Skin care" — optional grouping
  description String? @db.Text // Optional context for AI (review theming, ad analysis)

  // Ordering + state
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  // Provenance · "manual" (Maria typed it), "auto:google" (Google Business
  // category), "auto:dom" (extracted from her website). Auto entries can be
  // suppressed by setting isActive=false rather than deleted, so the
  // detector doesn't re-add them on the next cron pass.
  source String @default("manual")

  // Last time this service was mentioned in any Review row · updated by
  // R.4 service-mention extractor. Drives "stale service" tips on /reviews
  // (e.g. "Filler hasn't been mentioned in 4 months — consider promoting").
  lastMentionedAt DateTime?

  // ── Agency rework (additive) · self-building all-category taxonomy.
  canonicalKey String? // resolved ServiceTaxonomy.canonicalKey
  confidence   Float?
  detectedVia  String[] @default([]) // which extractor layers found it
  rawNames     String[] @default([]) // surface forms collapsed into this row
  embeddingId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, sortOrder])
  @@index([businessId, isActive])
  @@index([businessId, canonicalKey])
  @@index([canonicalKey])
}

// Weekly snapshot — preserves history for trend analysis
model BusinessSnapshot {
  id           String   @id @default(cuid())
  businessId   String
  snapshotDate DateTime @default(now())

  rating          Float?
  reviewCount     Int?
  photosCount     Int?
  replyRate       Float?
  velocityLast30d Int?
  mapslyScore     Float? // 0-10 composite
  msiRank         Int? // rank in metro
  msiTotal        Int?
  hoursPerWeek    Int?

  // Per-dimension sub-scores (denormalized for trend queries)
  reputationScore          Float?
  communicationScore       Float?
  profileCompletenessScore Float?
  trustScore               Float?
  pricingTransparencyScore Float?
  brandPresenceScore       Float?

  // ── Scoring v2 · market-relative pillars (modules/scoring/pillars.ts) ──────
  // Pillar INPUTS, denormalized as a typed bag so weekly:cell-aggregate and
  // pillar scoring read one row instead of re-joining Serp/Lighthouse/Ads.
  // Shape = PillarSignals (modules/scoring/pillar-types.ts).
  signalsJson Json?

  // Pillar OUTPUTS (0–10 each) + the consolidated v2 master (pillarScore).
  // Coexist with the legacy 6 sub-scores + mapslyScore until the SMB UI swaps.
  reputationPillar Float?
  visibilityPillar Float?
  profilePillar    Float?
  websitePillar    Float?
  adsPillar        Float?
  adsApplicable    Boolean? // is the business actually advertising (display flag)
  pillarScore      Float? // 0–10 · weighted roll-up of the 5 pillars
  msiPercentile    Float? // 0–100 · inverse rank percentile (90 = top 10%)
  cellKey          String? // "category|city|country" the scores were graded against
  cellConfidence   String? // "high" | "low" (low when cell sampleSize < 8)
  pillarRanks      Json? // { reputation, visibility, … } · rank within the cell per pillar
  cellSize         Int? // businesses in the cell (the per-pillar rank denominator)

  // ── Agency rework (additive) · informational ComplianceRisk pillar
  // (weight 0) + review trajectory scalars (§4.9, §4.15).
  complianceRiskPillar     Float?
  complianceRiskPercentile Float?
  reviewLifecycle          String? // TRENDING | STABLE | DYING | DORMANT
  qualityTrajectory        String?
  velocityPrev30d          Int?

  raw Json? // full source payload for replay

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, snapshotDate])
  @@index([businessId, snapshotDate])
}

// ============================================================================
// REVIEWS · weekly pull of last 20 per business; new-review delta daily
// ============================================================================

model Review {
  id                     String    @id @default(cuid())
  businessId             String
  externalId             String? // Google review ID
  reviewerName           String // anonymized to initials
  reviewerProfileReviews Int? // signal of trustworthiness
  stars                  Int
  text                   String?   @db.Text
  language               String? // 'en' / 'es' / etc.
  postedAt               DateTime
  ownerReplied           Boolean   @default(false)
  ownerReplyText         String?   @db.Text
  ownerReplyAt           DateTime?

  // Sentiment is now derived from stars at upsert time (1-2 = NEGATIVE,
  // 3 = NEUTRAL, 4-5 = POSITIVE) via modules/reviews/sentiment-from-stars.
  // The classifier in services/ai/sentiment.ts is retired from the runtime
  // path; star-based mapping is free, instant, and equally useful for the
  // /reviews tabs (Negative / Replied / All / Unanswered).
  sentiment      ReviewSentiment?
  themes         String[]         @default([]) // AI-extracted theme tags
  isUrgent       Boolean          @default(false) // 1★ unanswered > 7d
  aiReplyDraftEn String?          @db.Text
  aiReplyDraftEs String?          @db.Text

  // Owner clicked "Skip" on the /reviews page → moves the review to the
  // Skipped tab. Cleared (superseded) once a real owner reply lands
  // (ownerReplied=true), which takes precedence and shows it under Replied.
  skippedAt DateTime?

  // R.4 · AI-extracted entities. Populated by services/ai/extract-entities
  // during the daily backfill cron (modules/reviews/extract-entities-backfill).
  // Drives "names highlighted in review text" UI and "service mentions
  // vs your service list" comparator on /reviews.
  //
  // `entitiesExtractedAt` is the processing marker — distinguishes "not
  // yet extracted" (NULL) from "extracted, found nothing" (timestamp set,
  // arrays empty). Clear this field to schedule re-extraction (e.g. after
  // a service-catalog edit invalidates prior results).
  mentionedPeople     String[]  @default([])
  mentionedServices   String[]  @default([])
  entitiesExtractedAt DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  collectedAt DateTime @default(now())

  @@unique([businessId, externalId])
  @@index([businessId, postedAt])
  // Hot composite indexes for the SMB /reviews queries (modules/smb-reviews).
  // Without these, filtering by ownerReplied / isUrgent / sentiment at the
  // 50k-review scale degrades to a per-business scan.
  @@index([businessId, ownerReplied])
  @@index([businessId, isUrgent, postedAt])
  @@index([businessId, sentiment])
}

enum ReviewSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

// ============================================================================
// LIGHTHOUSE AUDIT · weekly for SMB clients; monthly for prospects
// ============================================================================

model LighthouseAudit {
  id         String   @id @default(cuid())
  businessId String
  auditedAt  DateTime @default(now())

  performance   Float? // 0-100
  accessibility Float?
  bestPractices Float?
  seo           Float?
  pwa           Float?

  // Core Web Vitals
  lcp        Float? // seconds
  cls        Float?
  inp        Float? // ms
  fcp        Float?
  tbt        Float?
  ttfb       Float?
  totalBytes Int?

  // Desktop preset scores (the set above is mobile — the primary view).
  // Populated when the audit runs the second, desktop Lighthouse pass; null
  // on mobile-only / pre-existing audits.
  desktopPerformance Float?
  desktopLcp         Float? // seconds
  desktopInp         Float? // ms
  desktopCls         Float?

  // Custom DOM checks
  hasLocalBusinessSchema Boolean?
  hasFaqSchema           Boolean?
  hasBookingCtaAboveFold Boolean?
  hasPhoneAboveFold      Boolean?
  napConsistent          Boolean?
  // True when the page's content is present in the raw (pre-JS) HTML — a
  // crawler that doesn't execute JS still sees it. False = JS-only shell
  // (Google-indexing risk). Null when the DOM-fetch leg failed.
  contentWithoutJs       Boolean?

  // Tech stack (Wappalyzer)
  techStack String[] @default([])

  // ── Agency rework (additive) · persist the discarded ~95% of the LHR blob
  // as pitchable wins + rollups (§4.13). Detail rows live in
  // LighthouseOpportunity (plain-FK model).
  opportunities        Json?
  diagnostics          Json?
  techDetectedAt       DateTime?
  techSource           String?
  perfSavingsMs        Int?
  a11yViolationCount   Int?
  a11yCriticalCount    Int?
  isOnHttps            Boolean?
  hasVulnerableLibrary Boolean?
  formFactor           String? // "mobile" | "desktop"

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, auditedAt])
}

// ============================================================================
// AD LIBRARY · daily diff for tracked competitors + tracked keyword lanes
// ============================================================================

model AdLibraryEntry {
  id           String     @id @default(cuid())
  businessId   String?
  platform     AdPlatform
  externalAdId String     @unique // Meta Ad ID or Google Transparency ID

  adCreativeBody String?   @db.Text
  landingUrl     String?
  startedAt      DateTime?
  endedAt        DateTime?
  isActive       Boolean   @default(true)

  // Targeting
  targetGeo    String?
  targetGender String?
  targetAgeMin Int?
  targetAgeMax Int?

  // Estimated metrics
  impressionsMid Int? // midpoint of banded estimate
  spendMidLow    Float?
  spendMidHigh   Float?

  // Keyword-lane match (for "off-keyword" flag)
  matchedKeyword String?

  // Advertiser + creative detail · populated by the Apify Meta actor and the
  // DataForSEO Google ads_search adapter so the SMB /ads page can render
  // competitor ad cards (who · on what platforms · what the creative looks like).
  advertiserName       String? // competitor display name
  advertiserExternalId String? // Google Transparency advertiser_id / Meta page owner
  pageId               String? // Facebook Page id (Meta)
  displayFormat        String? // text | image | video
  previewImageUrl      String? // creative thumbnail
  linkTitle            String?
  linkCaption          String?
  ctaText              String?
  platforms            String[] @default([]) // META: FACEBOOK/INSTAGRAM/THREADS/MESSENGER/AUDIENCE_NETWORK
  collationCount       Int? // # of near-identical creatives grouped

  // ── Agency rework (additive) · Apify-actor audit captured more fields (§4.10).
  spendBandUsd String? // banded spend label (e.g. "$1k–$5k")
  cards        Json? // multi-card creative payload
  region       String?

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([businessId, platform])
  @@index([businessId, isActive])
  @@index([matchedKeyword])
  @@index([advertiserExternalId])
}

enum AdPlatform {
  META
  GOOGLE
  TIKTOK
}

// One advertiser observed in a (category, city, country) MARKET CELL via the
// Meta Ad Library service-keyword search (e.g. "botox miami"). This is the
// market-intelligence layer for the SMB /ads page — who's advertising for a
// service in a city, on which platforms, with what creatives — collected ONCE
// per cell and shared across every business in it (the same cell-dedup pattern
// as keyword costs + SERP). Distinct from AdLibraryEntry, which is per-business.
model AdMarketAdvertiser {
  id String @id @default(cuid())

  // Market cell (matches Business.category / city / country).
  category     String
  city         String
  country      String
  locationCode Int // DataForSEO location code · cell-key parity with Keyword/SERP

  platform AdPlatform @default(META)

  // The advertiser, from the Ad Library.
  pageId        String // FB Page id — the stable advertiser key
  pageName      String
  handle        String? // @handle (from linkUrl / profile uri) when captured
  followerCount Int?
  pageCategory  String? // e.g. "Medical Spa"

  // Aggregate presence in this cell.
  activeAdCount   Int       @default(0)
  platforms       String[]  @default([]) // union across their ads: FACEBOOK/INSTAGRAM/…
  matchedServices String[]  @default([]) // which searched services surfaced them
  runningSince    DateTime?

  // Up to ~6 representative creatives for the gallery + (later · P5) AI analysis.
  // [{ externalAdId, body, previewUrl, format, landingUrl, platforms, startedAt }]
  creatives Json?

  // If this advertiser is one of our indexed businesses (matched by pageId /
  // handle / name), link it so we can flag "you" + dedup against AdLibraryEntry.
  matchedBusinessId String?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  isActive    Boolean  @default(true)

  @@unique([category, city, country, platform, pageId])
  @@index([category, city, country, isActive])
  @@index([matchedBusinessId])
  @@index([pageId])
}

// AI-derived, rule-bounded analysis of a market cell's Meta creatives (offers,
// formats, angles + a few suggestions). ONE row per cell, generated in the
// collection pipeline (cron/manual · cost-gated), read by the SMB /ads Meta
// block. Never generated in the user request path. See services/ai/ad-creative-insights.
model AdMarketInsight {
  id                String     @id @default(cuid())
  category          String
  city              String
  country           String
  platform          AdPlatform @default(META)
  // AI-extracted, rule-bounded. serviceMix: [{ service, ads }] · promos:
  // [{ label, offer, price }]. Deterministic numbers (% video, platform spread,
  // personalized gaps) are computed in the query layer, NOT stored here.
  serviceMix        Json
  promos            Json
  creativesAnalyzed Int        @default(0)
  model             String?
  generatedAt       DateTime   @default(now())

  @@unique([category, city, country, platform])
  @@index([category, city, country])
}

// ── Scoring v2 · CellMetric ─────────────────────────────────────────────────
// One row per (category, city, country) MARKET CELL holding the DISTRIBUTION of
// every scoreable signal across the cell's active businesses — the "market
// reference" that turns absolute thresholds ("150 reviews = good") into
// market-relative percentiles ("you're top 15% of Brickell med-spas"). Built
// ONCE per cell from existing BusinessSnapshot rows (zero external-API cost) by
// the weekly:cell-aggregate cron, read by pillar scoring (modules/scoring) and
// the /admin/cells page. Same cell-key shape as AdMarketAdvertiser / Keyword.
model CellMetric {
  id String @id @default(cuid())

  category String
  city     String
  country  String
  cellKey  String // "medical_spa|Miami|US" — denormalized for fast joins/reads

  sampleSize Int    @default(0) // active businesses with a snapshot in the cell
  confidence String @default("low") // "high" (sampleSize ≥ 8) | "low"

  // Headline medians/percentiles as scalar columns — so /admin/cells renders +
  // sorts without parsing JSON. p50 = median, p90 = "what the leaders look like".
  ratingP50         Float?
  reviewCountP50    Int?
  reviewCountP90    Int?
  photoCountP50     Int?
  replyRateP50      Float?
  velocityP50       Float?
  lighthousePerfP50 Int?
  shareOfVoiceP50   Float?
  adPrevalence      Float? // 0–1 · share of the cell running ads

  // Full per-signal breakpoints { signalKey: { p10,p25,p50,p75,p90 } } consumed
  // by percentileRank in pillar scoring. Shape = CellDistributions.
  distributions Json?

  // ── Agency rework (additive) · Cell Standards layer (§4.20).
  metroSlug      String?
  lastSnapshotAt DateTime?
  metricsVersion Int       @default(1)
  metricsDirty   Boolean   @default(false)

  computedAt DateTime @default(now())

  @@unique([category, city, country])
  @@index([cellKey])
  @@index([category, city, country])
  @@index([metroSlug])
}

// ============================================================================
// SERP / SEARCH VISIBILITY · weekly per tracked keyword × tracked business
// ============================================================================

model Keyword {
  id           String @id @default(cuid())
  keyword      String
  locationCode Int // DataForSEO location code
  language     String @default("en")

  // Search volume + cost · sourced from ranked_keywords response
  // (no separate monthly batch · S.1 plan v2)
  searchVolume     Int?
  cpc              Float?
  competition      String? // LOW / MEDIUM / HIGH
  competitionIndex Int?
  // Top-of-page bid range (USD) · from google_ads search_volume · the "what
  // ads cost" layer for the SMB /ads page. Market-level (per keyword+location),
  // shared across every business in a city cell (see ads-rework dedup rule).
  lowTopOfPageBid  Float?
  highTopOfPageBid Float?

  // Monthly-refreshed trend · DEPRECATED in S.1 plan v2 · kept for
  // backwards compat with the old monthly cron which we may retire.
  trend12Month Json?

  serpResults         SerpResult[]
  businessKeywords    BusinessKeyword[]
  quickWinAssignments QuickWinAssignment[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  refreshedAt DateTime?

  @@unique([keyword, locationCode, language])
}

// ============================================================================
// SEARCH VISIBILITY · BusinessKeyword join · ranked_keywords source-of-truth
// ============================================================================

/// One row per (Business × Keyword) that the business is known to rank for.
/// Populated by `discoverKeywordsForBusiness` from
/// `dataforseo_labs/google/ranked_keywords/live` and refreshed weekly.
///
/// The latest* fields are denormalized from the latest SerpResult for the
/// (business × keyword) pair · keeps the per-row admin/SMB table query
/// to a single SELECT without a JOIN.
model BusinessKeyword {
  id         String @id @default(cuid())
  businessId String
  keywordId  String

  /// Where this row came from.
  ///   "ranked"    — legacy · DfS ranked_keywords portfolio (S.1)
  ///   "template"  — S.6 · derived from local-intent templates
  ///                 (industry × city × services). Source the SMB
  ///                 /search page reads. Maria-facing.
  ///   "manual"    — admin add (reserved)
  source         String  @default("ranked")
  /// For source="template" rows, which template bucket produced this
  /// keyword. NULL for legacy "ranked" rows.
  ///   "core"      — always-on per industry (e.g. "med spa calgary")
  ///   "service"   — gated by services-detect output (e.g. "belkyra
  ///                 calgary" only if hasBelkyra)
  templateOrigin String?

  // Latest cached ranks · refreshed by discovery + cell-aggregate
  latestOrganicRank      Int?
  latestMapsRank         Int?
  latestLandingUrl       String?
  /// DfS `estimated_paid_traffic_cost` — what the equivalent paid traffic
  /// would cost at this rank. Source of truth for the "Traffic value" /
  /// "Customers/mo" column. Falls back to (sv × cpc × CTR-curve) for
  /// pre-v0.12.11 rows until the next weekly cron refresh.
  latestEstTrafficUsd    Float?
  /// DfS `etv` — estimated monthly clicks (visits) at this rank. Source
  /// of truth for the "visits" headline. NULL for pre-v0.12.11 rows;
  /// queries layer falls back to (sv × CTR-curve) until next cron.
  latestEstMonthlyVisits Float?
  latestScanAt           DateTime?

  // ranked_keywords delta flags · captured per scan so the UI can show
  // "↑12 improved · ↓5 dropped · 3 new" without recomputing.
  isNew  Boolean @default(false)
  isUp   Boolean @default(false)
  isDown Boolean @default(false)
  isLost Boolean @default(false)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  keyword  Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, keywordId])
  @@index([businessId, latestEstTrafficUsd]) // sort table by value desc
  @@index([keywordId]) // cell-aggregate lookup
}

/// Weekly Quick-Win assignments per business · S.6.5 (2026-05-28).
///
/// Each row = "this keyword was offered to this business as one of
/// the up-to-3 quick-win cards for the week starting Monday weekStart".
///
/// Why a separate table:
///   - Maria sees up to 3 fresh cards per week. Last week's set is
///     replaced with a new one even if she didn't act. The history
///     here lets us avoid suggesting the same keyword 4 weeks in a
///     row (rolling exclusion window).
///   - Decouples picking (when the cron or page render assigns) from
///     showing (the page just reads the current week's row set).
model QuickWinAssignment {
  id           String   @id @default(cuid())
  businessId   String
  keywordId    String
  /// Monday 00:00 UTC of the assignment week.
  weekStart    DateTime
  /// Which surface drove the qualification · "maps" (she's fringe
  /// in Maps Pack 4-10) or "search" (only organic 4-10 fringe).
  /// Drives the chip on the card + which i18n key set we render.
  surface      String
  /// Snapshot of the estimated customers/mo if she reached top 3
  /// for this keyword at assignment time. Carried with the assignment
  /// so the card's impact number doesn't drift even if rank/volume
  /// shifts mid-week.
  estCustomers Int
  createdAt    DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  keyword  Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([businessId, weekStart, keywordId])
  @@index([businessId, weekStart])
  @@index([businessId, keywordId, weekStart]) // rolling-exclusion lookup
}

model SerpResult {
  id         String   @id @default(cuid())
  keywordId  String
  businessId String? // nullable — could be a competitor not in our index yet
  scannedAt  DateTime @default(now())

  /// Which surface this rank is for · ORGANIC = Google web search,
  /// MAPS = Google Maps 3-pack / Local Finder. Same keyword can have
  /// both kinds of rank · one row per kind per scan.
  kind SerpResultKind @default(ORGANIC)

  localPackRank  Int? // 1-3 in the 3-pack, null if not in pack
  organicRank    Int? // organic position
  organicAbsRank Int? // absolute including ads
  landingUrl     String?

  // Top 3 in local pack (for competitive view)
  pack1Name String?
  pack2Name String?
  pack3Name String?

  // Brand hijack flag — for "search business name" type queries
  isBrandQuery Boolean @default(false)
  paidBidders  Json? // [{ advertiserDomain, headline }]

  keyword  Keyword   @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([keywordId, scannedAt])
  @@index([businessId, scannedAt])
  @@index([businessId, kind, scannedAt]) // per-surface trend queries
}

enum SerpResultKind {
  ORGANIC
  MAPS
}

// ============================================================================
// AGENCY · LISTS · LEADS
// ============================================================================

model List {
  id            String @id @default(cuid())
  agencyId      String
  ownerMemberId String

  name           String
  serviceType    ListServiceType
  pitch          String?         @db.Text
  filterJson     Json // serialized filter expression
  refreshCadence ListCadence     @default(WEEKLY)
  isActive       Boolean         @default(true)

  // Target market
  category String?
  metro    String?
  radiusMi Int?

  // ── Agency rework (additive) · raw-list provenance (§4.19). Scalar FK to
  // Discovery (no relation — Discovery is a plain-FK model).
  discoveryId String?
  isRaw       Boolean @default(false)

  agency    Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  owner     AgencyMember  @relation(fields: [ownerMemberId], references: [id])
  leads     Lead[]
  refreshes ListRefresh[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastRefreshedAt DateTime?
  pausedAt        DateTime?

  @@index([discoveryId])
}

enum ListServiceType {
  WEBSITE_REBUILD
  META_ADS_CAMPAIGN
  GOOGLE_ADS_LAUNCH
  LOCAL_SEO
  REVIEW_MANAGEMENT
  BRAND_DEFENSE
  NEW_BUSINESS_LAUNCH
  FULL_AUDIT
  CUSTOM
}

enum ListCadence {
  DAILY
  WEEKLY
  MANUAL
}

model ListRefresh {
  id          String   @id @default(cuid())
  listId      String
  refreshedAt DateTime @default(now())

  matchesBefore Int
  matchesAfter  Int
  added         Int // new qualifying businesses
  removed       Int // de-qualified

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId, refreshedAt])
}

model Lead {
  id         String @id @default(cuid())
  listId     String
  agencyId   String
  businessId String

  status          LeadStatus @default(NEW)
  statusChangedAt DateTime   @default(now())
  notes           String?    @db.Text
  matchScore      Float?

  // Closed-loop tracking (for analytics)
  contactedAt DateTime?
  repliedAt   DateTime?
  wonAt       DateTime?
  lostAt      DateTime?
  lostReason  String?

  // ── Agency rework (additive) · per-lead enrichment state for the jobs tray.
  enrichmentStateJson Json?

  list     List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  agency   Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listId, businessId])
  @@index([agencyId, status])
  // FT-2 agency-wide dedup: "businesses this agency already holds" is
  // SELECT DISTINCT businessId WHERE agencyId — one scan of this index.
  @@index([agencyId, businessId])
}

enum LeadStatus {
  NEW
  CONTACTED
  REPLIED
  WON
  LOST
  HIDDEN
}

// ============================================================================
// REPORTS · one-pagers, CSVs, shareable links
// ============================================================================

model Report {
  id         String  @id @default(cuid())
  agencyId   String
  businessId String? // null for list-level reports
  listId     String?

  type           ReportType
  status         ReportStatus @default(READY)
  publicShareId  String?      @unique // for shareable links
  shareExpiresAt DateTime?

  storageUrl String? // for PDF / CSV in Vercel Blob
  meta       Json? // generation params

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  viewCount Int      @default(0)
}

enum ReportType {
  CSV_LIST
  PDF_ONE_PAGER
  SHARE_LINK
}

enum ReportStatus {
  DRAFT
  READY
  SHARED
  EXPIRED
}

// ============================================================================
// LANDING PAGES · personalized public proposal pages (/l/[slug]-[token])
//
// One per qualified Business. The page renders that business's REAL latest
// snapshot data as a marketing proposal we email to the owner — the conversion
// surface that turns a discovered business into a paying SMB subscriber.
//
// `token` is a 16-digit numeric, unguessable lookup key (the only key we query
// by); `slug` is the cosmetic business-name segment in the URL, verified
// against the stored slug (mismatch → 404) so the link can't be edited to
// probe. No-indexed, rate-limited, kept out of the sitemap. See modules/smb-landing.
// ============================================================================

model LandingPage {
  id         String   @id @default(cuid())
  businessId String   @unique // one landing per business
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Unguessable numeric lookup key (16 digits) + cosmetic URL slug.
  token String @unique
  slug  String

  // Soft-revoke without deleting funnel history — flipping this 404s the link.
  isActive Boolean @default(true)

  // Denormalized open counter (fire-and-forget on render · cheap headline).
  // The authoritative funnel metrics live in LandingEvent.
  viewCount Int @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?

  events LandingEvent[]

  @@index([businessId])
}

// One captured funnel event for a landing page. Client-side events (open,
// section-viewed, CTA click, checkout opened) post to /api/landing-events;
// SUBSCRIPTION_BOUGHT is emitted server-side from the Stripe webhook via the
// landingToken carried in checkout metadata. Drives /admin/landing-pages.
model LandingEvent {
  id            String      @id @default(cuid())
  landingPageId String
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  type    LandingEventType
  // For SECTION_VIEWED: which section scrolled into view ("hero", "changes",
  // "search", "ads", "reviews", "website", "fixes", "pricing"). For
  // CTA_CLICKED: which CTA ("top", "hero", "fixes", "pricing").
  section String?

  // Visitor context. `visitorId` is a client-minted anonymous id (localStorage)
  // used to count UNIQUE visitors per funnel step; `sessionId` sequences one
  // page-load's events. `ipHash` is a salted hash (never the raw IP, per the
  // PII rule) for bot/duplicate filtering. `isBot` flags filtered traffic so
  // the admin funnel can exclude it.
  visitorId String?
  sessionId String?
  ipHash    String?
  userAgent String? @db.Text
  isBot     Boolean @default(false)
  // WHY isBot was set (plan #17 anti-bot stats) — null when isBot=false.
  // Values minted by lib/bot-detect.ts: "ua-scanner" (security scanner /
  // crawler UA) · "ua-proxy" (mail-provider image proxy) · "datacenter-ip"
  // (reserved · needs raw IP at ingest) · "no-engagement" (reserved ·
  // retro-classified sessions with PAGE_OPENED but zero SECTION_VIEWED).
  botReason String?

  // Conversion linkage (CHECKOUT_OPENED / SUBSCRIPTION_BOUGHT).
  stripeSessionId String?
  convertedUserId String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([landingPageId, type, createdAt])
  @@index([landingPageId, createdAt])
  @@index([visitorId])
  @@index([stripeSessionId])
}

enum LandingEventType {
  PAGE_OPENED
  SECTION_VIEWED
  CTA_CLICKED
  CHECKOUT_OPENED
  SUBSCRIPTION_BOUGHT
  // Free weekly-score signup (plan #7). Emitted SERVER-SIDE by the subscribe
  // endpoint (like SUBSCRIPTION_BOUGHT via the Stripe webhook) — NEVER
  // accepted from the client beacon at /api/landing-events; a client can't be
  // trusted to claim a conversion.
  FREE_SIGNUP
}

// ============================================================================
// CRON JOB LOGS — for audit + cost tracking
// ============================================================================

model CronRun {
  id             String        @id @default(cuid())
  job            String
  startedAt      DateTime      @default(now())
  finishedAt     DateTime?
  status         CronRunStatus @default(RUNNING)
  itemsProcessed Int           @default(0)
  costUsd        Float?
  errorMessage   String?       @db.Text
  meta           Json?

  @@index([job, startedAt])
}

enum CronRunStatus {
  RUNNING
  OK
  PARTIAL
  FAILED
}

// ============================================================================
// TASK TRACKER · source of truth for the autonomous build loop work queue
// PLAN.md becomes a derived markdown mirror (regenerated on every state change)
// ============================================================================

model TaskGroup {
  id          String     @id // "A" "B.smb-portal" — domain-flavored
  name        String // "Foundation" · "SMB portal" · "Data collection"
  description String?    @db.Text
  domain      TaskDomain
  sortOrder   Int        @default(0)
  ownerUrl    String?    @db.Text // dev surface for this group (e.g. /dev/tasks?group=E)
  targetDate  DateTime?
  notes       String?    @db.Text

  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([domain, sortOrder])
}

enum TaskDomain {
  FOUNDATION // CI, deploy, schema, auth, dev dashboard
  MARKETING // public landing, SEO, sign-in
  DATA // external APIs, crons, cache, cost tracking
  COMPUTE // scoring, MSI, signal vocab, AI
  SMB_PORTAL // Maria's portal pages
  AGENCY_PORTAL // Tom's portal pages
  BILLING // Stripe, plans, tier enforcement
  OPS // dev dashboard, task tracker, incident system, observability
  I18N // locales, translations, hreflang
}

model Task {
  id      String    @id // free-form ID — kept human-readable e.g. "A.1" "smb.dashboard.kpi"
  groupId String
  group   TaskGroup @relation(fields: [groupId], references: [id])

  title       String     @db.Text
  description String?    @db.Text // user story + acceptance criteria
  effort      String? // "S" | "M" | "L" | "XL"
  status      TaskStatus @default(PENDING)
  priority    Int        @default(50) // 0=highest, 100=lowest · controls loop pick order
  deps        String? // comma-separated task IDs
  tags        String? // comma-separated tags
  sortOrder   Int        @default(0) // order within the group

  // Last-run summary (denormalized for fast list rendering)
  scoreAvg         Float?
  scoreCompletion  Int?
  scoreQuality     Int?
  scoreAudience    Int?
  scoreRelevance   Int?
  scorePerformance Int?
  lastPrNumber     Int?
  lastPrUrl        String? @db.Text
  lastCommitSha    String?
  lastSessionId    String? // owner during IN_PROGRESS, last completer otherwise

  notes String? @db.Text

  // Pre-computed task context (v0.7.0 · saves ~15 turns/tick by avoiding
  // runtime grep/match for related files, INCs, rules). Populated when
  // Task is created or modified — see scripts/compute-task-context.ts.
  // Loop's STEP 3 returns this inline; STEP 4 reads it instead of
  // re-deriving via subagent.
  contextBundle Json?

  // Parallelism control (H.12)
  parallelLane String? // "auth" | "data" | "compute" | "smb-ui" | "agency-ui" | "billing" | "ops" | "i18n" | "shared"
  independent  Boolean @default(false) // can run alongside ANY other task
  filesPlanned String? @db.Text // JSON array of file paths the task will touch

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  startedAt    DateTime?
  completedAt  DateTime?
  failureCount Int       @default(0)

  runs TaskRun[]

  @@index([status, groupId, sortOrder])
  @@index([parallelLane, status])
  @@index([groupId, sortOrder])
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  BLOCKED
  SKIPPED
  FAILED
  HUMAN_REQUIRED
}

// Per-attempt audit trail · one row per time the loop touches the task
model TaskRun {
  id         String         @id @default(cuid())
  taskId     String
  task       Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sessionId  String // links to autonomous-build-loop session
  startedAt  DateTime       @default(now())
  finishedAt DateTime?
  outcome    TaskRunOutcome @default(IN_PROGRESS)

  // Scoring
  scoreCompletion  Int?
  scoreQuality     Int?
  scoreAudience    Int?
  scoreRelevance   Int?
  scorePerformance Int?
  scoreAggregate   Float?

  // Shipping
  branchName   String?
  prNumber     Int?
  prUrl        String? @db.Text
  commitSha    String?
  filesChanged String? @db.Text // JSON array of file paths
  linesAdded   Int?
  linesDeleted Int?
  testsAdded   Int     @default(0)

  // Resume chain · when this run continued from a prior INCOMPLETE run
  resumedFromRunId String?

  // Quality gates
  ciPassed         Boolean?
  deployPassed     Boolean?
  lighthousePassed Boolean?

  // Audit trail
  agentsUsed     String? @db.Text // JSON array of agent names invoked
  skillsUsed     String? @db.Text // JSON array of skill names invoked
  rulesConsulted String? @db.Text // JSON array of rule file paths read
  mcpsUsed       String? @db.Text // JSON array of MCP server names

  // Cost / scale
  tokensInput  Int?
  tokensOutput Int?
  costUsd      Float?
  durationSec  Int?

  // Failure + learning
  incidentsLogged String? @db.Text // JSON array of INC- IDs
  errorMessage    String? @db.Text

  // Validation strategy + outcomes (see .claude/rules/validation.md)
  validationStrategy String? @db.Text // JSON: which modes were chosen + why
