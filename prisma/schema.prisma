  // discovery attribution (a run overlapping two discoveries' cells was counted
  // by both). Nullable: pre-FK rows resolve via the cellKeys fallback.
  discoveryId        String?
  triggeredByUserId  String
  enrichmentsJson    Json
  scopeKind          String
  scopeRefsJson      Json
  status             EnrichmentRunStatus @default(PENDING)
  estimatedUsd       Decimal             @default(0) @db.Decimal(10, 4)
  actualUsd          Decimal             @default(0) @db.Decimal(10, 4)
  creditsHeld        Int                 @default(0)
  creditsCharged     Int                 @default(0)
  unitsRequested     Int                 @default(0)
  unitsCompleted     Int                 @default(0)
  unitsSkippedFresh  Int                 @default(0)
  unitsSkippedHidden Int                 @default(0)
  startedAt          DateTime            @default(now())
  finishedAt         DateTime?
  errorMessage       String?             @db.Text
  workflowRunId      String?
  meta               Json?

  @@index([agencyId, status])
  @@index([discoveryId, status])
  @@index([startedAt])
}

// One enrichment family applied to one business — the unit the jobs tray polls.
model EnrichmentJob {
  id            String              @id @default(cuid())
  businessId    String
  family        EnrichmentFamily
  status        EnrichmentJobStatus @default(QUEUED)
  costUsd       Decimal             @default(0) @db.Decimal(10, 4)
  runId         String?
  workflowRunId String?
  attempts      Int                 @default(0)
  // Exponential-backoff marker (WP0-5) · the pool-claim query filters
  // `nextAttemptAt <= now() OR nextAttemptAt IS NULL`. Stamped on requeue in
  // WP3-6; null means immediately eligible.
  nextAttemptAt DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  errorMessage  String?             @db.Text
  createdAt     DateTime            @default(now())

  @@index([businessId, family])
  @@index([status])
  @@index([runId, status])
  @@index([status, createdAt])
  // WP3-6 · covering index for the backoff-aware pool claim
  // (`WHERE status='QUEUED' AND (nextAttemptAt IS NULL OR nextAttemptAt <= now())`
  // ORDER BY createdAt, id). nextAttemptAt leads so the range predicate is an
  // index scan; createdAt keeps the deterministic ordering (WP3-12).
  @@index([status, nextAttemptAt, createdAt])
  // P5 (2026-07-10) · covering index for the business-unit progress bump —
  // bumpRunProgress runs 2 COUNTs per terminal transition filtered on exactly
  // (runId, businessId, status); without this, businessId filtered in-memory
  // off [runId, status] on high-fan-out runs (code-review Low-3).
  @@index([runId, businessId, status])
}

// Per-agency research entitlement ledger (entitlement model · 2026-07-08).
//
// The ONE object that expresses "agency X paid for (business|cell × family)".
// Research STORAGE stays global (no agencyId on research tables — the margin
// lever); this ledger is the per-agency REVENUE axis. `hasEntitlement` = a row
// exists (D1 · PERMANENT-view — no expiry; grantedAt is provenance only). A
// refresh charges only when the shared data is stale (read the global cursor,
// never grantedAt).
//
// Exactly one of businessId / cellKey is set (per-business families vs the
// per-cell meta_ads/serp). Enforced by a raw CHECK
// `((businessId IS NULL) <> (cellKey IS NULL))` in the migration — Prisma can't
// express it, and Postgres NULLS DISTINCT would otherwise let a both-null /
// wrong-null row escape both unique indexes and silently double-mint.
//
// The two @@unique keys double as the batched-read indexes for the workbench
// hot path (WHERE agencyId AND businessId IN (...) AND family IN (...)).
model AgencyEntitlement {
  id             String           @id @default(cuid())
  agencyId       String
  businessId     String?
  cellKey        String?
  family         EnrichmentFamily
  grantedAt      DateTime         @default(now())
  sourceRunId    String?
  creditsCharged Int              @default(0)
  createdAt      DateTime         @default(now())

  @@unique([agencyId, businessId, family])
  @@unique([agencyId, cellKey, family])
  @@index([agencyId, family])
  @@index([businessId])
  @@index([cellKey])
}

// Credit wallet per agency. Credit columns are non-null @default(0) (INC-32).
model AgencyWallet {
  id               String   @id @default(cuid())
  agencyId         String   @unique
  planCredits      Int      @default(0)
  purchasedCredits Int      @default(0)
  rolloverCredits  Int      @default(0)
  heldCredits      Int      @default(0)
  // DEAD (B8): cycleResetAt is written but never read; overageEnabled/overageCapUsd
  // are never read or written (the CreditLedgerType.EXPIRE enum is likewise never
  // emitted). Rollover is handled at grant time (server.ts nextRolloverCredits),
  // not via a cycle-reset cron. Kept to avoid a destructive migration; drop them
  // in a deliberate schema-cleanup migration (human-required).
  cycleResetAt     DateTime
  overageEnabled   Boolean  @default(false)
  overageCapUsd    Decimal? @db.Decimal(10, 2)
  updatedAt        DateTime @updatedAt
}

// Append-only credit movements (hold → settle → refund-diff).
model CreditLedger {
  id        String           @id @default(cuid())
  agencyId  String
  type      CreditLedgerType
  credits   Int              @default(0)
  usd       Decimal          @default(0) @db.Decimal(10, 4)
  runId     String?
  note      String?
  createdAt DateTime         @default(now())

  @@index([agencyId, createdAt])
  @@index([runId, type])
}

// ── Discovery (§4.3, §4.19) ──────────────────────────────────────────────────

// The user request spanning cells (user-facing "Research"). Snapshot-guarded by
// idempotencyKey. Count/USD rollups are non-null @default(0).
model Discovery {
  id                String          @id @default(cuid())
  agencyId          String
  requestedByUserId String
  name              String?
  intentCampaignId  String?
  idempotencyKey    String          @unique
  status            DiscoveryStatus @default(PENDING)
  researchStatus    ResearchStatus  @default(ACTIVE)
  isPinned          Boolean         @default(false)
  viewPref          String?
  lastOpenedAt      DateTime?
  cellKeys          String[]        @default([])
  cellCount         Int             @default(0)
  freshCount        Int             @default(0)
  refetchedCount    Int             @default(0)
  totalBusinesses   Int             @default(0)
  totalCostUsd      Float           @default(0)
  cohortSize        Int             @default(0)
  spendToDateUsd    Float           @default(0)
  freshnessJson     Json?
  loopProgressJson  Json?
  // The research's active signal set + per-signal tune values, persisted from
  // the goal step so the workbench can EVALUATE each lead against the chosen
  // signals (match % from signal-eval, not a heuristic). Shape:
  // { signals: Array<{ key, tune?, conds?, match? }> }.
  signalsJson       Json?
  workflowRunId     String?
  createdAt         DateTime        @default(now())
  // Stamped by app code when the discovery flips to RUNNING (WP0-4) so
  // stuck-discovery recovery (WP3-5) anchors on real run-start, not enqueue.
  startedAt         DateTime?
  finishedAt        DateTime?

  @@index([agencyId, createdAt])
  @@index([agencyId, researchStatus])
  @@index([status])
}

// Per-cell outcome within a Discovery (served-from-DB vs refetched vs new).
model DiscoveryCell {
  id                String               @id @default(cuid())
  discoveryId       String
  trackedLocationId String
  cellKey           String
  outcome           DiscoveryCellOutcome
  discoveryRunId    String?
  businessCount     Int                  @default(0)
  dfsCostUsd        Float                @default(0)
  createdAt         DateTime             @default(now())

  @@unique([discoveryId, trackedLocationId])
  @@index([trackedLocationId])
}

// Per-run coverage snapshot of a cell (trend of market size over time).
model CellSnapshot {
  id                 String   @id @default(cuid())
  trackedLocationId  String
  cellKey            String
  discoveryRunId     String?
  capturedAt         DateTime @default(now())
  businessCount      Int      @default(0)
  totalAvailable     Int?
  openCount          Int      @default(0)
  closedForeverCount Int      @default(0)

  @@index([trackedLocationId, capturedAt(sort: Desc)])
}

// ── Contacts & reachability (§4.5) ───────────────────────────────────────────

// Normalized multi-channel contact (email/phone/social/booking) per business.
model Contact {
  id              String         @id @default(cuid())
  businessId      String
  channel         ContactChannel
  value           String
  normalizedValue String
  role            ContactRole    @default(UNKNOWN)
  source          ContactSource
  confidence      Int            @default(0)
  verifiedStatus  VerifiedStatus @default(UNVERIFIED)
  verifiedAt      DateTime?
  isPrimary       Boolean        @default(false)
  meta            Json?
  // Contact-level do-not-sell / opt-out flag (WP0-7) · stamped by the /opt-out
  // flow (WP7-2). When set, this channel is excluded from CSV export, touch
  // generation, and one-pagers. Nullable = not opted out.
  optedOutAt      DateTime?
  firstSeenAt     DateTime       @default(now())
  lastSeenAt      DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([businessId, channel, normalizedValue])
  @@index([businessId, channel])
  @@index([channel, verifiedStatus])
  @@index([businessId, isPrimary])
}

// ── Reviews rearchitecture (§4.8) ────────────────────────────────────────────

// Durable review-pull state machine (Vercel Queues + Workflow DevKit).
model ReviewJob {
  id            String          @id @default(cuid())
  businessId    String
  mode          String // "full" | "delta"
  status        ReviewJobStatus @default(QUEUED)
  taskId        String?
  depth         Int             @default(200)
  attempts      Int             @default(0)
  windowDays    Int             @default(365)
  lastError     String?         @db.Text
  workflowRunId String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status])
  @@index([businessId])
}

// ── DOM / tech fingerprint (§4.6) ────────────────────────────────────────────

// Wappalyzer-style detected technology per business (mirrors BusinessService).
model BusinessTech {
  id         String               @id @default(cuid())
  businessId String
  name       String
  category   BusinessTechCategory
  confidence Float                @default(0)
  source     String
  detectedAt DateTime             @default(now())

  @@index([businessId, category])
  @@index([name])
}

// ── Ads — per cell (§4.10, §4.11) ────────────────────────────────────────────

// Per-cell ad-market run (30-day gate) — serve from DB if fresh.
model AdMarketRun {
  id              String   @id @default(cuid())
  cellKey         String
  platform        String
  ranAt           DateTime @default(now())
  status          String
  costUsd         Float    @default(0)
  advertiserCount Int      @default(0)
  adCount         Int      @default(0)
  // P5 (2026-07-10) · primary Apify run id (META only) — lets the reconcile
  // cron fetch the run's FINALIZED usage after the fact instead of trusting a
  // same-second estimate (Apify finalizes usage a beat after terminal, often
  // past our function budget · INC-56). Null for non-Apify platforms/old rows.
  apifyRunId      String?
  // P5 · per-collection telemetry: { outcome, apifyRunIds[], chunks,
  // pendingTargets, costEstimated, errors[] }. The reconcile cron keys off
  // costEstimated (backfill real usage) + pendingTargets (chunk continuation).
  detailJson      Json?

  @@index([cellKey, platform, ranAt(sort: Desc)])
  // P5 · the reconcile cron scans "recent META rows" with no cellKey bound.
  @@index([platform, ranAt(sort: Desc)])
}

// ── Services taxonomy (§4.7) ─────────────────────────────────────────────────

// Self-building, all-category service taxonomy with embedding merge.
model ServiceTaxonomy {
  id           String   @id @default(cuid())
  categorySlug String
  canonicalKey String
  displayName  String
  group        String?
  synonyms     String[] @default([])
  embedding    Float[]  @default([])
  status       String   @default("seed")
  occurrences  Int      @default(0)
  source       String   @default("seed")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([categorySlug, canonicalKey])
  @@index([categorySlug, status])
}

// Cell-level service prevalence — the comparative "X% of the cell offers this".
model CellServicePrevalence {
  id           String   @id @default(cuid())
  cellKey      String
  category     String
  city         String
  country      String
  canonicalKey String
  displayName  String
  prevalence   Float    @default(0)
  rank         Int      @default(0)
  sampleSize   Int      @default(0)
  source       String   @default("internal")
  computedAt   DateTime @default(now())

  @@unique([cellKey, canonicalKey])
  @@index([cellKey, rank])
}

// ── Lighthouse opportunities (§4.13) ─────────────────────────────────────────

// One failing/pitchable Lighthouse audit, normalized out of the LHR blob.
model LighthouseOpportunity {
  id                String   @id @default(cuid())
  lighthouseAuditId String
  businessId        String
  bucket            String // Speed | ADA | Security | Mobile-SEO | Third-party
  auditKey          String
  score             Float?
  weight            Float?
  savingsMs         Int?
  savingsBytes      Int?
  displayValue      String?
  itemCount         Int?
  createdAt         DateTime @default(now())

  @@index([businessId, bucket])
  @@index([auditKey])
}

// ── Expert layer / playbooks (§4.15) ─────────────────────────────────────────

// Per-vertical profile (vocabulary, regulations, benchmarks) — code-versioned.
model CategoryProfile {
  id                     String   @id @default(cuid())
  categorySlug           String
  displayName            String
  version                Int      @default(1)
  vocabulary             Json?
  regulations            Json?
  benchmarks             Json?
  pitchNuances           Json?
  licenseSource          Json?
  scoringWeightOverrides Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([categorySlug, version])
}

// State-board license record (feeds license_status signal).
model BusinessLicense {
  id            String    @id @default(cuid())
  businessId    String
  state         String
  licenseNumber String?
  trade         String?
  status        String
  verifiedAt    DateTime?
  source        String?
  createdAt     DateTime  @default(now())

  @@index([businessId])
}

// Evidence-mandatory playbook finding (compliance/expert signal verdict).
model PlaybookFinding {
  id               String   @id @default(cuid())
  businessId       String
  playbookId       String
  playbookVersion  Int      @default(1)
  signalKey        String
  group            String
  value            String
  confidence       String
  corroboration    Int      @default(0)
  evidenceJson     Json?
  explanation      String   @db.Text
  pitchAngle       String   @db.Text
  status           String
  notCheckedReason String?
  feedback         String?
  computedAt       DateTime @default(now())

  @@unique([businessId, signalKey])
  @@index([playbookId, signalKey, confidence])
  @@index([businessId, status])
  @@index([signalKey, feedback])
}

// ── Demand / intent → strategy (§4.16) ───────────────────────────────────────

// Agency campaign intake (selling-what / buyer-ICP / pain-points / budget).
model Campaign {
  id                String   @id @default(cuid())
  agencyId          String
  createdByUserId   String
  name              String?
  sellingWhat       String?  @db.Text
  buyerIcp          String?  @db.Text
  painPoints        String?  @db.Text
  budgetHintUsd     Float?
  proposedPlanJson  Json?
  signalWeightsJson Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([agencyId])
}

// A pain point mapped to the signal keys that detect it.
model CampaignPainPoint {
  id         String   @id @default(cuid())
  campaignId String
  label      String
  signalKeys String[] @default([])
  createdAt  DateTime @default(now())

  @@index([campaignId])
}

// Reusable intent → strategy template (e.g. "sell websites").
model StrategyTemplate {
  id                     String   @id @default(cuid())
  slug                   String   @unique
  name                   String
  sellingWhat            String?
  recommendedCategories  String[] @default([])
  recommendedEnrichments String[] @default([])
  signalWeightsJson      Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// Costed research plan derived from a campaign.
model ResearchPlan {
  id               String   @id @default(cuid())
  campaignId       String
  discoveryId      String?
  planJson         Json
  estimatedCostUsd Float    @default(0)
  createdAt        DateTime @default(now())

  @@index([campaignId])
}

// ── Personalized touch (§4.17) ───────────────────────────────────────────────

// A generated first-touch / sequence step grounded in real signals.
model OutreachDraft {
  id              String   @id @default(cuid())
  businessId      String
  // Owning agency · backfilled from the generating agency in app code (WP0 is
  // a safe additive migration; nullable until WP1+ populates + reads it). The
  // WP5 touch-gen + security waves filter every draft read/write by agencyId.
  agencyId        String?
  campaignId      String?
  leadId          String?
  // A12 (touchpoints audit 2026-07-07) · soft ref to the ConsentRecord that
  // logs the consent BASIS this email touch relies on (CASL s.10(9)(b)
  // conspicuous publication / CAN-SPAM opt-out). Written at generation time,
  // best-effort — null when consent logging failed or the channel isn't email.
  // MVP audit trail: looked up FROM the draft, so no index needed yet.
  consentRecordId String?
  channel         String
  subject         String?
  body            String   @db.Text
  whyJson         Json?
  predictedTier   String?
  status          String   @default("draft")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([campaignId])
  @@index([businessId])
  @@index([agencyId])
}

// Outreach lifecycle event (sent / open / reply / bounce) — reply/bounce truth.
model OutreachEvent {
  id         String   @id @default(cuid())
  draftId    String?
  leadId     String?
  type       String
  occurredAt DateTime @default(now())
  raw        Json?

  @@index([draftId, type])
  @@index([leadId, type])
}

// Raw pitch intent capture (free-text → parsed JSON).
model PitchIntent {
  id         String   @id @default(cuid())
  agencyId   String
  campaignId String?
  raw        String?  @db.Text
  parsedJson Json?
  createdAt  DateTime @default(now())

  @@index([agencyId])
}

// ── Location selection (§4.2) ────────────────────────────────────────────────

// Saved multi-metro × multi-category pick.
model LocationSelection {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  metroSlugs  String[] @default([])
  categoryIds String[] @default([])
  createdAt   DateTime @default(now())

  @@index([ownerId])
}

// ── AI research enrichment (§4.14) ───────────────────────────────────────────

// Per-business rollup of the 5-stage AI research pipeline (gpt-5.4-nano).
model BusinessEnrichment {
  id                     String   @id @default(cuid())
  businessId             String   @unique
  subType                String? // ER-1 sub-type classification
  sophistication         String? // ER-1 sophistication (low|medium|high)
  pricingTransparency    String? // ER-2 (transparent|opaque|unknown)
  positioningSummary     String?  @db.Text // ER-2
  complianceCues         String[] @default([]) // ER-3 regulatory cues
  painHypotheses         String[] @default([]) // ER-4 outreach pain points
  competitivePositioning String?  @db.Text // ER-5 vs cell leader
  model                  String?
  costUsd                Float    @default(0)
  computedAt             DateTime @default(now())

  @@index([businessId])
}

// One row per AI-research stage run (audit + per-stage freshness + cost).
model EnrichmentStageRun {
  id           String   @id @default(cuid())
  businessId   String
  stage        String // "ER-1".."ER-5"
  status       String   @default("OK") // OK|FAILED|SKIPPED_FRESH
  outputJson   Json?
  model        String?
  costUsd      Float    @default(0)
  errorMessage String?  @db.Text
  computedAt   DateTime @default(now())

  @@index([businessId, stage])
}

// ── Activation analytics (WP0-8) ─────────────────────────────────────────────

// Server-side product events for activation funnels — no new vendor. Inserted
// via a helper (WP6-4): signup, agency_created, goal_selected, enrich_started,
// first_lead_drawer_opened, csv_exported, credit_exhausted_hit, etc. agencyId /
// userId are nullable so anonymous / pre-agency events can still land.
model ProductEvent {
  id        String   @id @default(cuid())
  agencyId  String?
  userId    String?
  type      String
  propsJson Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([agencyId, createdAt])
}

// ── Saved goal templates (WP0-9) ─────────────────────────────────────────────

// Per-agency saved research playbook (save-as-template · WP5-12). `signalsJson`
// mirrors Discovery.signalsJson shape; `basedOnTemplate` is the GOAL_TEMPLATES
// key it was cloned from (null for from-scratch).
model AgencyTemplate {
  id              String   @id @default(cuid())
  agencyId        String
  name            String
  basedOnTemplate String?
  signalsJson     Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([agencyId])
}
