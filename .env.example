# ─────────────────────────────────────────────────────────────────────────────
# AUTONOMOUS LOOP · model selection
# ─────────────────────────────────────────────────────────────────────────────

# Loop runs on the latest Opus by default. Override here as new models ship.
# Examples (use the model id you actually have access to):
#   CLAUDE_MODEL=claude-opus-4-6
#   CLAUDE_MODEL=claude-opus-4-7        # if 4.7 is released
#   CLAUDE_MODEL=opus                   # alias for latest opus (if CLI supports)
CLAUDE_MODEL="claude-opus-4-6"

# ============================================================================
# MAPSLY · .env.example
# Copy to .env.local and fill in. NEVER commit .env.local
# See docs/handoff.md for where to get each value.
# ============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# CORE — required to boot the app
# ─────────────────────────────────────────────────────────────────────────────

# Database — Neon Postgres (free tier OK for dev)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.neon.tech/mapsly?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.neon.tech/mapsly?sslmode=require"

# Auth — NextAuth v5
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"  # alias for compat

# Email — Resend (magic links + transactional)
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="login@mapsly.ai"
RESEND_REPLY_TO="support@mapsly.ai"

# Cron secret — used by Vercel cron headers
CRON_SECRET="generate-with: openssl rand -hex 32"

# ─────────────────────────────────────────────────────────────────────────────
# DATA SOURCES — required for the actual product to function
# ─────────────────────────────────────────────────────────────────────────────

# DataForSEO — Maps SERP, Reviews API, Keyword Volume, Lighthouse, SERP organic
# Sign up: https://dataforseo.com  · pay-as-you-go, ~$50 min deposit
DATAFORSEO_USERNAME="your-email@example.com"
DATAFORSEO_PASSWORD="your-api-password"

# Meta Ad Library — free, requires app + access token
# Sign up: https://developers.facebook.com/docs/marketing-api/insights
META_AD_LIBRARY_ACCESS_TOKEN="EAAxxx"

# Google Search Console — service-account JSON path (for `mcp__gsc__*` agent use)
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# Google Analytics 4 — same service account, separate property
GA4_PROPERTY_ID="123456789"

# ─────────────────────────────────────────────────────────────────────────────
# AI
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI — review sentiment, AI reply drafts, one-pager copy
# Models: gpt-5.4-mini (default) or gpt-5.4-nano (cheaper, set via D.8 A/B test)
OPENAI_API_KEY="sk-xxx"

# Anthropic — legacy / fallback only (we use OpenAI now per D.8 decision)
ANTHROPIC_API_KEY="sk-ant-xxx"

# ─────────────────────────────────────────────────────────────────────────────
# BILLING
# ─────────────────────────────────────────────────────────────────────────────

STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

STRIPE_PRICE_SMB_PAID="price_xxx"           # $29
STRIPE_PRICE_AGENCY_SOLO="price_xxx"        # $49
STRIPE_PRICE_AGENCY_GROWTH="price_xxx"      # $99
STRIPE_PRICE_AGENCY_PRO="price_xxx"         # $249
STRIPE_PRICE_AGENCY_BOUTIQUE="price_xxx"    # $499

# ─────────────────────────────────────────────────────────────────────────────
# STORAGE
# ─────────────────────────────────────────────────────────────────────────────

# Vercel Blob — PDF one-pagers, CSV exports
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# ─────────────────────────────────────────────────────────────────────────────
# OBSERVABILITY
# ─────────────────────────────────────────────────────────────────────────────

# Sentry
SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
SENTRY_AUTH_TOKEN="sntrys_xxx"
SENTRY_ORG="mapsly"
SENTRY_PROJECT="javascript-nextjs"


# ─────────────────────────────────────────────────────────────────────────────
# DEPLOY
# ─────────────────────────────────────────────────────────────────────────────

VERCEL_ENV="development"   # set automatically by Vercel
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Mapsly"

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — for connectors / future integrations
# ─────────────────────────────────────────────────────────────────────────────

# Apify (for Reddit / scraping — roadmap Phase 2)
APIFY_TOKEN=""

