# ─────────────────────────────────────────────────────────────────────────────
# AUTONOMOUS LOOP · model selection
# ─────────────────────────────────────────────────────────────────────────────

# Loop runs on the latest Opus by default. Override here as new models ship.
# Examples (use the model id you actually have access to):
#   CLAUDE_MODEL=claude-opus-4-7
#   CLAUDE_MODEL=opus                   # alias for latest opus (if CLI supports)
CLAUDE_MODEL="claude-opus-4-7"

# Extended-thinking budget per Claude CLI invocation. Opus 4.7 supports the
# scale: low | medium | high | xhigh | max. The loop defaults to "max" because
# Pro Max session budget is the cap (not per-call cost) and deeper reasoning
# means better scoring + fewer recurring incidents. Override to "high" or
# "xhigh" if you want faster ticks.
#
# CLAUDE_CODE_EFFORT_LEVEL is the canonical name read by the CLI itself.
# The shorter CLAUDE_EFFORT_LEVEL is honored too (legacy fallback).
CLAUDE_CODE_EFFORT_LEVEL="max"

# ============================================================================
# MAPSLY · .env.example
# Copy to .env.local and fill in. NEVER commit .env.local
# See docs/handoff.md for where to get each value.
# ============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# CORE — required to boot the app
# ─────────────────────────────────────────────────────────────────────────────

# Database — Neon Postgres (free tier OK for dev)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.neon.tech/mapsly?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.neon.tech/mapsly?sslmode=require"

# Auth — NextAuth v5
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"  # alias for compat

# Email — Resend (magic links + transactional)
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="login@mapsly.ai"
RESEND_REPLY_TO="support@mapsly.ai"

# Email verification — SMTP probe identity (services/email-verify · C.6)
# heloHost MUST be a real, resolvable hostname so destination MX servers
# do not reject the conversation for failed reverse-DNS / SPF posture.
# mailFrom defaults to postmaster@<heloHost> if unset.
SMTP_VERIFY_HELO_HOST="mapsly.ai"
SMTP_VERIFY_MAIL_FROM="postmaster@mapsly.ai"

# Cron secret — used by Vercel cron headers
CRON_SECRET="generate-with: openssl rand -hex 32"

# ─────────────────────────────────────────────────────────────────────────────
# DATA SOURCES — required for the actual product to function
# ─────────────────────────────────────────────────────────────────────────────

# DataForSEO — Maps SERP, Reviews API, Keyword Volume, Lighthouse, SERP organic
# Sign up: https://dataforseo.com  · pay-as-you-go, ~$50 min deposit
DATAFORSEO_USERNAME="your-email@example.com"
DATAFORSEO_PASSWORD="your-api-password"

# Meta Ad Library — free, requires app + access token
# Sign up: https://developers.facebook.com/docs/marketing-api/insights
META_AD_LIBRARY_ACCESS_TOKEN="EAAxxx"

# Google Search Console — service-account JSON path (for `mcp__gsc__*` agent use)
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# Google Analytics 4 — same service account, separate property
GA4_PROPERTY_ID="123456789"

# ─────────────────────────────────────────────────────────────────────────────
# AI
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI — review sentiment, AI reply drafts, one-pager copy
# Models: gpt-5.4-mini (default) or gpt-5.4-nano (cheaper, set via D.8 A/B test)
OPENAI_API_KEY="sk-xxx"
# Optional · override the OpenAI API base URL (Azure proxy, mock server).
# Defaults to https://api.openai.com/v1 when unset.
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Anthropic — legacy / fallback only (we use OpenAI now per D.8 decision)
ANTHROPIC_API_KEY="sk-ant-xxx"

# ─────────────────────────────────────────────────────────────────────────────
# BILLING
# ─────────────────────────────────────────────────────────────────────────────

STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

STRIPE_PRICE_SMB_PAID="price_xxx"           # $29
STRIPE_PRICE_AGENCY_SOLO="price_xxx"        # $49  (legacy agency tiers)
STRIPE_PRICE_AGENCY_GROWTH="price_xxx"      # $99
STRIPE_PRICE_AGENCY_PRO="price_xxx"         # $249
STRIPE_PRICE_AGENCY_BOUTIQUE="price_xxx"    # $499

# Agency "Billing & credits" page — prototype pricing model (Free/Starter/
# Growth/Scale). Create these as NEW Stripe products + prices. Until set, the
# matching plan/top-up CTA degrades to a disabled "Contact us" button.
STRIPE_PRICE_PLAN_STARTER="price_xxx"       # $19/mo · 900 credits (subscription)
STRIPE_PRICE_PLAN_GROWTH="price_xxx"        # $99/mo · 6,000 credits (subscription)
STRIPE_PRICE_PLAN_SCALE="price_xxx"         # $299/mo · 24,000 credits (subscription)
STRIPE_PRICE_TOPUP_1000="price_xxx"         # $50 one-time · +1,000 credits (payment)
STRIPE_PRICE_TOPUP_5000="price_xxx"         # $200 one-time · +5,000 credits (payment)

# ─────────────────────────────────────────────────────────────────────────────
# STORAGE
# ─────────────────────────────────────────────────────────────────────────────

# Vercel Blob — PDF one-pagers, CSV exports
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# ─────────────────────────────────────────────────────────────────────────────
# OBSERVABILITY
# ─────────────────────────────────────────────────────────────────────────────

# Sentry
SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
SENTRY_AUTH_TOKEN="sntrys_xxx"
SENTRY_ORG="mapsly"
SENTRY_PROJECT="javascript-nextjs"


# ─────────────────────────────────────────────────────────────────────────────
# DEPLOY
# ─────────────────────────────────────────────────────────────────────────────

VERCEL_ENV="development"   # set automatically by Vercel
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Mapsly"

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — for connectors / future integrations
# ─────────────────────────────────────────────────────────────────────────────

# Apify (for Reddit / scraping — roadmap Phase 2)
APIFY_TOKEN=""


# ── Cold Email (self-hosted SMTP outreach on mapsly.xyz) ──────────────────
# See docs/cold-email-setup.md. Walled off from Resend/mapsly.ai.
# ONLY the mailbox credentials are required. SMTP host (smtp.zohocloud.ca),
# from-name, base URL, unsubscribe secret (reuses AUTH_SECRET), and the legal
# footer address are all hardcoded in services/cold-mailer/config.ts.
# Display + sign-off name auto-derives from the address (ava@ -> "Ava").
COLD_MAILBOX_1=ava@mapsly.xyz
COLD_MAILBOX_PASSWORD_1=
COLD_MAILBOX_2=mia@mapsly.xyz
COLD_MAILBOX_PASSWORD_2=
COLD_MAILBOX_3=noah@mapsly.xyz
COLD_MAILBOX_PASSWORD_3=
COLD_MAILBOX_4=leo@mapsly.xyz
COLD_MAILBOX_PASSWORD_4=
COLD_MAILBOX_5=sofia@mapsly.xyz
COLD_MAILBOX_PASSWORD_5=
# Optional overrides (defaults live in services/cold-mailer/config.ts):
# COLD_SMTP_HOST=smtp.zohocloud.ca
# COLD_SMTP_PORT=465
# COLD_PHYSICAL_ADDRESS=...   # override the hardcoded legal footer
# COLD_GLOBAL_PAUSE=1         # hard kill-switch (UI toggle preferred)
