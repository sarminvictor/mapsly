{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/weekly/reviews-delta",
      "schedule": "30 11 * * 1"
    },
    {
      "path": "/api/cron/weekly/search-visibility",
      "schedule": "0 12 * * 1"
    },
    {
      "path": "/api/cron/weekly/lighthouse-audit",
      "schedule": "30 12 * * 1"
    },
    {
      "path": "/api/cron/weekly/snapshot-write",
      "schedule": "30 13 * * 1"
    },
    {
      "path": "/api/cron/weekly/ads-intelligence",
      "schedule": "0 15 * * 1"
    },
    {
      "path": "/api/cron/weekly/ads-meta",
      "schedule": "30 15 * * 1"
    }
  ],
  "functions": {
    "app/api/cron/**/*.ts": {
      "maxDuration": 300
    },
    "app/api/webhooks/**/*.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
