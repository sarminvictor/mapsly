{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/process-cold-sequences",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/poll-cold-inboxes",
      "schedule": "5,20,35,50 * * * *"
    },
    {
      "path": "/api/cron/internal/reviews-reconcile",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/internal/dispatch",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/internal/run-finished-emails",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/weekly/market-moved-digest",
      "schedule": "0 13 * * 2"
    },
    {
      "path": "/api/cron/weekly/market-monitor",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/cron/weekly/retention-sweep",
      "schedule": "0 4 * * 0"
    }
  ],
  "functions": {
    "app/api/cron/**/*.ts": {
      "maxDuration": 300
    },
    "app/api/webhooks/**/*.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
